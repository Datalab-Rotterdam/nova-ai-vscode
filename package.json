{
  "name": "nova-ai-vscode",
  "displayName": "Nova AI",
  "description": "Use Nova AI models as native chat models in Visual Studio Code.",
  "version": "1.0.18",
  "publisher": "datalabrotterdam",
  "icon": "resources/icons/icon-512-rounded.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Datalab-Rotterdam/nova-ai-vscode.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "enabledApiProposals": [
    "chatParticipantAdditions",
    "chatProvider",
    "languageModelThinkingPart",
    "languageModelSystem",
    "languageModelPricing"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "nova",
    "ai",
    "chat",
    "language model"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:nova.sidebar",
    "onChatParticipant:nova-ai.nova",
    "onCommand:nova.manage",
    "onCommand:nova.signIn",
    "onCommand:nova.signOut",
    "onCommand:nova.refreshModels",
    "onCommand:nova.openChat",
    "onCommand:nova.openSettings",
    "onCommand:nova.newChat",
    "onCommand:nova.focusChat",
    "onCommand:nova.addSelectionToChat",
    "onCommand:nova.openChatInEditor",
    "onWebviewPanel:nova.chatPanel",
    "onWebviewPanel:nova.skills",
    "onCommand:nova.showHistory",
    "onCommand:nova.showAccount",
    "onCommand:nova.showHelp"
  ],
  "contributes": {
    "markdown.previewStyles": [
      "./resources/help/preview.css"
    ],
    "chatParticipants": [
      {
        "id": "nova-ai.nova",
        "name": "nova",
        "fullName": "Nova AI",
        "description": "Agentic coding with Nova AI models and VS Code tools",
        "isSticky": true,
        "isAgent": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain how the selected or attached code works"
          },
          {
            "name": "fix",
            "description": "Find and fix a problem in the code"
          },
          {
            "name": "tests",
            "description": "Write tests for the selected or attached code"
          },
          {
            "name": "compact",
            "description": "Summarize the conversation so far to free up context"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "nova-ai",
        "displayName": "Nova AI",
        "managementCommand": "nova.manage"
      }
    ],
    "chatAgents": [
      {
        "path": "./resources/chat/agents/nova.agent.md"
      }
    ],
    "chatPromptFiles": [
      {
        "path": "./resources/chat/prompts/nova-review.prompt.md"
      },
      {
        "path": "./resources/chat/prompts/nova-explain.prompt.md"
      },
      {
        "path": "./resources/chat/prompts/nova-tests.prompt.md"
      }
    ],
    "languageModelTools": [
      {
        "name": "nova_fetch_url",
        "displayName": "Fetch Web Page (Nova)",
        "toolReferenceName": "novaFetch",
        "canBeReferencedInPrompt": true,
        "icon": "$(globe)",
        "tags": [
          "web",
          "nova"
        ],
        "userDescription": "Read a web page by URL and give its main content to the model.",
        "modelDescription": "Fetch a web page (http or https) and return its main content as text with links, or the raw body for text and JSON. Use it to read documentation, issues or articles the user refers to. Long pages are cut; pass startChar to read on. This tool cannot search the web: it needs a concrete URL.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "Absolute http(s) URL."
            },
            "startChar": {
              "type": "integer",
              "minimum": 0,
              "description": "Character offset to continue from (shown at the end of a cut page)."
            }
          },
          "required": [
            "url"
          ]
        }
      },
      {
        "name": "nova_memory_read",
        "displayName": "Read Nova Memory",
        "toolReferenceName": "novaMemory",
        "canBeReferencedInPrompt": true,
        "icon": "$(book)",
        "tags": [
          "nova",
          "memory"
        ],
        "userDescription": "Read Nova's saved global and project memory.",
        "modelDescription": "Read Nova's saved memory: global notes about the user and project notes about this workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "global",
                "project"
              ]
            }
          }
        }
      },
      {
        "name": "nova_memory_write",
        "displayName": "Update Nova Memory",
        "toolReferenceName": "novaRemember",
        "canBeReferencedInPrompt": true,
        "icon": "$(bookmark)",
        "tags": [
          "nova",
          "memory"
        ],
        "userDescription": "Remember, update, forget or consolidate Nova memories.",
        "modelDescription": "Change memory that persists across chats. Keep it small and current: one short fact per entry, no secrets or personal data. Actions: 'remember' adds a fact (text); 'replace' updates entries containing match with text (use it when a fact changed); 'forget' removes entries containing match; 'rewrite' replaces all entries with text (one per line) to consolidate. Scope global is about the user, scope project about this workspace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "remember",
                "replace",
                "forget",
                "rewrite"
              ]
            },
            "scope": {
              "type": "string",
              "enum": [
                "global",
                "project"
              ]
            },
            "text": {
              "type": "string",
              "description": "remember/replace: the fact. rewrite: all entries, one per line."
            },
            "match": {
              "type": "string",
              "description": "replace/forget: text identifying the entries to change."
            }
          },
          "required": [
            "action",
            "scope"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "nova.manage",
        "title": "Nova AI: Manage Account",
        "category": "Nova AI"
      },
      {
        "command": "nova.signIn",
        "title": "Nova AI: Sign In",
        "category": "Nova AI"
      },
      {
        "command": "nova.signOut",
        "title": "Nova AI: Sign Out",
        "category": "Nova AI",
        "icon": "$(sign-out)"
      },
      {
        "command": "nova.refreshModels",
        "title": "Nova AI: Refresh Models",
        "category": "Nova AI",
        "icon": "$(refresh)"
      },
      {
        "command": "nova.openChat",
        "title": "Nova AI: Open Chat",
        "category": "Nova AI"
      },
      {
        "command": "nova.openSettings",
        "title": "Nova AI: Open Settings",
        "category": "Nova AI",
        "icon": "$(settings-gear)"
      },
      {
        "command": "nova.manageModels",
        "title": "Nova AI: Manage Language Models",
        "category": "Nova AI",
        "icon": "$(list-selection)"
      },
      {
        "command": "nova.newChat",
        "title": "Nova AI: New Chat",
        "category": "Nova AI",
        "icon": "$(add)"
      },
      {
        "command": "nova.focusChat",
        "title": "Nova AI: Open Nova Chat",
        "category": "Nova AI"
      },
      {
        "command": "nova.addSelectionToChat",
        "title": "Add to Nova Chat",
        "category": "Nova AI"
      },
      {
        "command": "nova.openChatInEditor",
        "title": "Nova AI: Open Chat in Editor",
        "category": "Nova AI",
        "icon": "$(link-external)"
      },
      {
        "command": "nova.openGlobalMemory",
        "title": "Nova AI: Open Global Memory",
        "category": "Nova AI"
      },
      {
        "command": "nova.openProjectMemory",
        "title": "Nova AI: Open Project Memory",
        "category": "Nova AI"
      },
      {
        "command": "nova.revealHome",
        "title": "Nova AI: Reveal Nova Folder",
        "category": "Nova AI"
      },
      {
        "command": "nova.cleanUpProjects",
        "title": "Nova AI: Clean Up Projects",
        "category": "Nova AI"
      },
      {
        "command": "nova.showHistory",
        "title": "Nova AI: Chats",
        "category": "Nova AI",
        "icon": "$(history)"
      },
      {
        "command": "nova.showAccount",
        "title": "Nova AI: Account and Models",
        "category": "Nova AI",
        "icon": "$(account)"
      },
      {
        "command": "nova.chats.search",
        "title": "Nova AI: Search Chats",
        "category": "Nova AI",
        "icon": "$(search)"
      },
      {
        "command": "nova.chats.openInEditor",
        "title": "Open in Editor",
        "category": "Nova AI"
      },
      {
        "command": "nova.chats.rename",
        "title": "Rename…",
        "category": "Nova AI"
      },
      {
        "command": "nova.chats.delete",
        "title": "Delete",
        "category": "Nova AI"
      },
      {
        "command": "nova.manageSkills",
        "title": "Nova AI: Manage Skills",
        "category": "Nova AI",
        "icon": "$(book)"
      },
      {
        "command": "nova.showHelp",
        "title": "Nova AI: Help",
        "category": "Nova AI",
        "icon": "$(question)"
      },
      {
        "command": "nova.setUpBrowser",
        "title": "Nova AI: Set Up Browser Integration",
        "category": "Nova AI",
        "icon": "$(globe)"
      },
      {
        "command": "nova.dev.testLinks",
        "title": "Nova AI (Dev): Test Chat Links",
        "category": "Nova AI"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nova.newChat",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "nova.showHistory",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "navigation@2"
        },
        {
          "command": "nova.openChatInEditor",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "navigation@3"
        },
        {
          "command": "nova.manageModels",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "1_models@1"
        },
        {
          "command": "nova.refreshModels",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "1_models@2"
        },
        {
          "command": "nova.openProjectMemory",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "2_memory@1"
        },
        {
          "command": "nova.openGlobalMemory",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "2_memory@2"
        },
        {
          "command": "nova.revealHome",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "2_memory@3"
        },
        {
          "command": "nova.openSettings",
          "when": "view == nova.sidebar",
          "group": "3_settings@1"
        },
        {
          "command": "nova.signOut",
          "when": "view == nova.sidebar && nova.signedIn",
          "group": "3_settings@2"
        },
        {
          "command": "nova.manageSkills",
          "when": "view == nova.sidebar",
          "group": "2_memory@4"
        },
        {
          "command": "nova.showHelp",
          "when": "view == nova.sidebar",
          "group": "4_help@1"
        }
      ],
      "editor/context": [
        {
          "command": "nova.addSelectionToChat",
          "when": "nova.signedIn && resourceScheme == file",
          "group": "nova@1"
        }
      ],
      "commandPalette": [
        {
          "command": "nova.addSelectionToChat",
          "when": "nova.signedIn && editorIsOpen"
        },
        {
          "command": "nova.dev.testLinks",
          "when": "nova.devMode"
        },
        {
          "command": "nova.chats.search",
          "when": "nova.signedIn"
        },
        {
          "command": "nova.chats.openInEditor",
          "when": "false"
        },
        {
          "command": "nova.chats.rename",
          "when": "false"
        },
        {
          "command": "nova.chats.delete",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "nova.chats.openInEditor",
          "when": "webviewSection == 'novaChatRow'",
          "group": "1_open@1"
        },
        {
          "command": "nova.chats.rename",
          "when": "webviewSection == 'novaChatRow'",
          "group": "2_edit@1"
        },
        {
          "command": "nova.chats.delete",
          "when": "webviewSection == 'novaChatRow'",
          "group": "2_edit@2"
        }
      ]
    },
    "icons": {
      "nova-logo": {
        "description": "Nova AI logo",
        "default": {
          "fontPath": "./resources/fonts/nova.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nova",
          "title": "Nova AI",
          "icon": "resources/favicon.svg"
        }
      ]
    },
    "views": {
      "nova": [
        {
          "type": "webview",
          "id": "nova.sidebar",
          "name": ""
        }
      ]
    },
    "configuration": [
      {
        "title": "Nova AI",
        "properties": {
          "nova.enableDiagnostics": {
            "type": "boolean",
            "default": false,
            "description": "Enable verbose Nova AI diagnostics logging in the output panel."
          },
          "nova.browser.autoSetup": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Set up the Nova AI browser integration on startup: registers the Nova AI Browser host with your Chromium-based browsers (Chrome, Edge, Brave, …) and installs the `nova-browser` skill, so Nova can use your browser through the Nova AI browser extension. Nothing changes when it is already current. Run **Nova AI: Set Up Browser Integration** to do it by hand."
          },
          "nova.chat.rewriteAssistantIdentity": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "When a Nova model is used from VS Code Chat or agent mode, replace the built-in assistant identity (\"GitHub Copilot\") in the system prompt with Nova's. Tool and workspace instructions are kept."
          },
          "nova.models.editTools": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "find-replace",
                "multi-find-replace",
                "apply-patch",
                "code-rewrite"
              ],
              "enumDescriptions": [
                "Find and replace text in a file.",
                "Find and replace several snippets across files.",
                "File-oriented diff format, works best with models trained on it.",
                "Rewrite a code snippet; general but slower."
              ]
            },
            "uniqueItems": true,
            "default": [
              "find-replace",
              "multi-find-replace"
            ],
            "markdownDescription": "Edit tools VS Code agent mode offers to Nova models. Most open models edit more reliably with find/replace than with `apply-patch`. Requires a VS Code version with the language model provider edit-tools hint."
          },
          "nova.context.defaultContextWindow": {
            "type": "integer",
            "default": 32768,
            "minimum": 1024,
            "markdownDescription": "Context window (in tokens) assumed for Nova models that do not advertise one."
          },
          "nova.context.autoCompact": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Automatically compact long conversations so they fit the model's context window. `@nova` summarizes older turns; requests from VS Code Chat are trimmed only when they would overflow."
          },
          "nova.context.compactThreshold": {
            "type": "number",
            "default": 0.8,
            "minimum": 0.3,
            "maximum": 0.95,
            "markdownDescription": "Share of the model's input budget at which `@nova` compacts the conversation."
          },
          "nova.agent.maxToolRounds": {
            "type": "integer",
            "default": 25,
            "minimum": 1,
            "maximum": 200,
            "markdownDescription": "Maximum number of model ↔ tool rounds `@nova` runs for one request."
          },
          "nova.agent.approvalMode": {
            "type": "string",
            "enum": [
              "ask",
              "autoReadOnly",
              "autoAll"
            ],
            "default": "autoReadOnly",
            "enumDescriptions": [
              "Ask before every tool call.",
              "Run read-only tools (read, search, problems) automatically; ask before edits and commands.",
              "Run all tools without asking."
            ],
            "markdownDescription": "When the Nova chat asks for approval before running a tool."
          },
          "nova.agent.commandTimeoutSeconds": {
            "type": "integer",
            "default": 120,
            "minimum": 5,
            "maximum": 3600,
            "markdownDescription": "Time limit for commands the Nova chat runs."
          },
          "nova.agent.includeMcpTools": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Offer MCP server tools registered in VS Code to the Nova chat."
          },
          "nova.home": {
            "type": "string",
            "default": "",
            "scope": "machine",
            "markdownDescription": "Folder for Nova's memory, chats and scratch files. Empty uses `~/.nova-ai` (or the `NOVA_AI_HOME` environment variable)."
          },
          "nova.memory.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Include Nova's memory (`~/.nova-ai/MEMORY.md`, the project's `MEMORY.md`, and the repository's `NOVA.md` / `AGENTS.md`) in Nova chats, and let Nova save new memories (with your approval)."
          }
        }
      },
      {
        "title": "Developer Settings",
        "properties": {
          "nova.developer.parseModelCapabilities": {
            "type": "boolean",
            "default": true,
            "description": "Parse model capabilities returned by Nova AI into VS Code native model capability flags."
          }
        }
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "npm run clean && npm run build:webview && npm run typecheck && npm run build:extension",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --outfile=out/extension.js --sourcemap",
    "build:webview": "vite build --config vite.webview.config.mts",
    "dev:webview": "vite build --watch --config vite.webview.config.mts",
    "package:vsix": "npm run compile && mkdir -p dist && vsce package --pre-release --out dist/nova-ai-vscode.vsix",
    "publish:marketplace": "vsce publish --pre-release --allow-proposed-apis chatParticipantAdditions chatProvider languageModelThinkingPart languageModelSystem languageModelPricing --packagePath dist/nova-ai-vscode.vsix --pat \"$AZURE_DEVOPS_TOKEN\"",
    "publish:ovsx": "ovsx verify-pat datalabrotterdam --pat \"$OVSX_PAT\" && (ovsx create-namespace datalabrotterdam --pat \"$OVSX_PAT\" || true) && ovsx publish dist/nova-ai-vscode.vsix --pre-release --pat \"$OVSX_PAT\"",
    "verify": "npm test && npm run package:vsix",
    "typecheck": "tsc -p ./ --noEmit",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "pretest": "npm run compile"
  },
  "dependencies": {
    "@datalabrotterdam/nova-sdk": "^1.3.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^24.7.2",
    "@types/vscode": "^1.120.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.9.1",
    "dompurify": "^3.4.16",
    "esbuild": "^0.25.12",
    "marked": "^15.0.12",
    "ovsx": "^0.10.11",
    "sass": "^1.99.0",
    "semantic-release": "^25.0.3",
    "svelte": "^5.38.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
